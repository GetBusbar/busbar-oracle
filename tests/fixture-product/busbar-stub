"""The FIXTURE PRODUCT'S binary: the smallest thing the oracle can be pointed at and still be a
product rather than a mock of one.

The oracle judges a product it knows nothing about. Proving that claim needs a product, and using
the real busbar for it would put the tool's CI back inside the tree it was extracted from -- the
exact coupling the extraction removed. So this file is a busbar-shaped answering machine: it says
its version, it accepts or refuses a config, and it serves the two routes a cheap cell drives.

  busbar-stub --version                 -> `busbar 0.0.0-fixture` on stdout, exit 0
  busbar-stub --validate                -> reads $BUSBAR_CONFIG (or the path given), exit 0 if the
  busbar-stub --validate <config>          config is present and names a listen address; exit 1 with
                                           a reason on stderr otherwise
  busbar-stub --serve                   -> serve, binding the `listen:` address of $BUSBAR_CONFIG
  busbar-stub --serve <config>             (or of the config given), after validating it

Routes, and nothing else:
  GET  /healthz              200 `ok`             the readiness poll every driver waits on
  GET  /v1/models            200 a model list     enough for a listener to be worth talking to
  POST /v1/chat/completions  200 a completion     the one recorded cell's request

DELIBERATELY NOT REAL. There is no auth, no store, no upstream and no plugin loading. `--validate`
refuses a missing or shapeless config because a validator that always exits 0 proves nothing about
the recorder that calls it, and that refusal is the only judgement this file makes.

Stdlib only, and no state on disk: whatever a self-test starts, killing it removes.
"""
from __future__ import annotations

import json
import os
import re
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

VERSION = "busbar 0.0.0-fixture"

# The completion body is FIXED, byte for byte, on purpose: a recorded cell that carries a timestamp,
# a random id or a counter diverges from itself on the next replay, and the oracle's own self-tests
# would then be measuring the fixture's clock instead of the differ.
COMPLETION = {
    "id": "chatcmpl-fixture",
    "object": "chat.completion",
    "model": "m-fixture",
    "choices": [
        {
            "index": 0,
            "finish_reason": "stop",
            "message": {"role": "assistant", "content": "pong"},
        }
    ],
    "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2},
}
MODELS = {"object": "list", "data": [{"id": "m-fixture", "object": "model", "owned_by": "fixture"}]}


def read_config(path: str) -> str:
    with open(path, encoding="utf-8") as fh:
        return fh.read()


def listen_addr(text: str) -> tuple[str, int] | None:
    """The `listen: "host:port"` line, in the one shape the fixture config is written in."""
    m = re.search(r'^\s*listen:\s*"?([^"\s]+):(\d+)"?\s*$', text, re.M)
    if not m:
        return None
    return m.group(1), int(m.group(2))


def validate(path: str) -> int:
    if not path:
        print("busbar-stub: no config: pass one as an argument or set BUSBAR_CONFIG", file=sys.stderr)
        return 1
    try:
        text = read_config(path)
    except OSError as e:
        print(f"busbar-stub: cannot read config {path}: {e}", file=sys.stderr)
        return 1
    if listen_addr(text) is None:
        print(f"busbar-stub: config {path} names no `listen: \"host:port\"`", file=sys.stderr)
        return 1
    print(f"busbar-stub: config {path} ok")
    return 0


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):  # the recorder captures stderr; a request log is noise in it
        pass

    def _send(self, code: int, body: bytes, ctype: str) -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _json(self, code: int, obj) -> None:
        self._send(code, json.dumps(obj, sort_keys=True).encode(), "application/json")

    def do_GET(self):  # noqa: N802  (http.server's spelling)
        if self.path == "/healthz":
            self._send(200, b"ok", "text/plain")
        elif self.path == "/v1/models":
            self._json(200, MODELS)
        else:
            self._json(404, {"error": {"message": "no such route", "type": "not_found"}})

    def do_POST(self):  # noqa: N802
        length = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(length) if length else b""
        if self.path != "/v1/chat/completions":
            self._json(404, {"error": {"message": "no such route", "type": "not_found"}})
            return
        try:
            req = json.loads(raw or b"{}")
        except ValueError:
            self._json(400, {"error": {"message": "body is not JSON", "type": "invalid_request"}})
            return
        if not isinstance(req, dict) or not req.get("messages"):
            self._json(400, {"error": {"message": "`messages` is required", "type": "invalid_request"}})
            return
        self._json(200, COMPLETION)


def serve(path: str) -> int:
    if validate(path) != 0:
        return 1
    host, port = listen_addr(read_config(path))
    srv = ThreadingHTTPServer((host, port), Handler)
    srv.daemon_threads = True
    # The address is printed AFTER the socket is bound, so a caller that waits for this line has
    # waited for a listener rather than for a process.
    print(f"busbar-stub: listening on {host}:{port}", flush=True)
    t = threading.Thread(target=srv.serve_forever, daemon=True)
    t.start()
    try:
        t.join()
    except KeyboardInterrupt:
        srv.shutdown()
    return 0


def main(argv: list[str]) -> int:
    args = list(argv)
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if args[0] in ("--version", "-V", "version"):
        print(VERSION)
        return 0
    if args[0] == "--validate":
        return validate(args[1] if len(args) > 1 else os.environ.get("BUSBAR_CONFIG", ""))
    if args[0] == "--serve":
        return serve(args[1] if len(args) > 1 else os.environ.get("BUSBAR_CONFIG", ""))
    print(f"busbar-stub: unknown argument {args[0]!r}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
